{
  "gemini": {
    "label": "Google Gemini",
    "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
    "auth": "bearer",
    "schema_flavour": "plain",
    "audio_in_chat": true,
    "default_model": "gemini-3.5-flash-lite",
    "models": ["gemini-3.5-flash-lite", "gemini-3.8-flash"],
    "params": {"reasoning_effort": "minimal", "max_tokens": 300},
    "model_params": {"gemini-3.8-flash": {"reasoning_effort": "low"}},
    "drop_params": ["parallel_tool_calls", "seed", "store"],
    "stream_usage": "stream_options",
    "headers": {},
    "stt": null,
    "free_tier": {
      "note": "about 500 requests a day on Flash-Lite",
      "quota_url": "https://aistudio.google.com/",
      "resets_tz": "America/Los_Angeles"
    },
    "languages": ["en", "sl"],
    "key_help_url": "https://aistudio.google.com/apikey",
    "verified": "2026-10-02"
  },
  "openai": {
    "label": "OpenAI",
    "base_url": "https://api.openai.com/v1",
    "auth": "bearer",
    "schema_flavour": "strict",
    "audio_in_chat": false,
    "default_model": "gpt-5-mini",
    "models": ["gpt-5-mini", "gpt-5-nano"],
    "params": {"reasoning_effort": "minimal", "max_completion_tokens": 300},
    "drop_params": [],
    "stream_usage": "stream_options",
    "headers": {},
    "stt": {"path": "/audio/transcriptions", "model": "gpt-4o-mini-transcribe"},
    "free_tier": null,
    "languages": ["en"],
    "key_help_url": "https://platform.openai.com/api-keys",
    "verified": null
  },
  "xai": {
    "label": "Grok (xAI)",
    "base_url": "https://api.x.ai/v1",
    "auth": "bearer",
    "schema_flavour": "strict",
    "audio_in_chat": false,
    "default_model": "grok-4.20-0309-non-reasoning",
    "models": ["grok-4.20-0309-non-reasoning"],
    "params": {"max_tokens": 300},
    "drop_params": ["stop", "presence_penalty", "frequency_penalty"],
    "stream_usage": "stream_options",
    "headers": {"x-grok-conv-id": "{session_id}"},
    "stt": null,
    "free_tier": null,
    "languages": ["en"],
    "key_help_url": "https://console.x.ai/",
    "verified": null
  },
  "groq": {
    "label": "Groq",
    "base_url": "https://api.groq.com/openai/v1",
    "auth": "bearer",
    "schema_flavour": "strict",
    "audio_in_chat": false,
    "default_model": "openai/gpt-oss-20b",
    "models": ["openai/gpt-oss-20b"],
    "params": {"max_completion_tokens": 300},
    "drop_params": [],
    "stream_usage": "stream_options",
    "headers": {},
    "stt": {"path": "/audio/transcriptions", "model": "whisper-large-v3-turbo"},
    "free_tier": {
      "note": "about 1,000 requests and 200,000 tokens a day",
      "quota_url": "https://console.groq.com/settings/limits"
    },
    "languages": ["en"],
    "key_help_url": "https://console.groq.com/keys",
    "verified": null
  },
  "ollama": {
    "label": "My own PC (Ollama)",
    "base_url": "http://{host}:11434/v1",
    "allow_http": true,
    "auth": "none",
    "schema_flavour": "plain",
    "audio_in_chat": false,
    "default_model": "qwen3:8b",
    "models": ["qwen3:8b"],
    "params": {"max_tokens": 300, "keep_alive": "30m"},
    "drop_params": [],
    "stream_usage": "stream_options",
    "headers": {},
    "stt": null,
    "free_tier": null,
    "languages": ["en"],
    "key_help_url": "https://ollama.com/download",
    "verified": null
  }
}
