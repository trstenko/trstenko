[Unit]
Description=Trstenko
# bootcheck runs first and may point `current` at the previous release, so
# this unit must resolve the symlink after it has finished, not before.
After=network.target trstenko-bootcheck.service sound.target
Requires=trstenko-bootcheck.service

[Service]
Type=simple
WorkingDirectory=/opt/trstenko/current
ExecStart=/opt/trstenko/current/venv/bin/python -m firmware.main
Environment=TRSTENKO_ROOT=/opt/trstenko
Environment=TRSTENKO_DATA=/var/lib/trstenko
Restart=always
RestartSec=3

# Least privilege. The app draws a face, talks to a sound card and a screen,
# and writes to two directories; it has no business anywhere else. EN 18031
# asks for this and it costs nothing.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# The two it may write to: its own releases and its own data.
ReadWritePaths=/opt/trstenko /var/lib/trstenko
# SPI, GPIO and the USB sound card.
DeviceAllow=char-spi rw
DeviceAllow=char-gpiochip rw
DeviceAllow=char-snd rw

# Five failures in a minute is a release that does not work. Give up rather
# than restart-looping: bootcheck counts those boots and rolls back, and a
# tight loop only burns the SD card while it does.
StartLimitBurst=5
StartLimitIntervalSec=60
OnFailure=trstenko-rollback.service

[Install]
WantedBy=multi-user.target
