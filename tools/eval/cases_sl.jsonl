{"lang": "sl", "say": "prižgi luči v dnevni sobi", "expect_tool": null, "max_words": 25, "reply_not": "\\b(prižgal|prižgane|urejeno)\\b"}
{"lang": "sl", "say": "kakšno bo jutri vreme", "expect_tool": null, "max_words": 25, "reply_not": "\\b(sončno|deževalo|stopinj)\\b", "note": "v1 nima orodja za vreme: to mora povedati, ne izmisliti napovedi"}
