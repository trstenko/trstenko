{"lang": "sl", "say": "povečaj glasnost", "expect_tool": "set_volume", "max_words": 10, "local": true, "expect_args": {"change": "up"}}
{"lang": "sl", "say": "to je preglasno", "expect_tool": "set_volume", "expect_args": [{"change": "down"}, {"level<": 60}], "max_words": 12}
{"lang": "sl", "say": "nastavi glasnost na trideset odstotkov", "expect_tool": "set_volume", "expect_args": {"level": 30}, "max_words": 10}
{"lang": "sl", "say": "govori malo tišje, prosim", "expect_tool": "set_volume", "expect_args": [{"change": "down"}, {"level<": 60}], "max_words": 12}
