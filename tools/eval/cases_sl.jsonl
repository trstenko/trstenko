# Slovenski primeri za vrednotenje (plan 08). En primer na vrstico; ključi so opisani v score.py.
# Stavke je napisal Claude; 3. 10. 2026 jih je pregledal Maj (naravni govorec).
# "now" je privzeto 2026-10-02T15:10 (petek), Europe/Ljubljana.
# --- opomniki: pravo orodje in pravilno izračunan čas
{"lang": "sl", "say": "opomni me ob šestih, naj pokličem mamo", "expect_tool": "set_reminder", "expect_args": {"when": "2026-10-02T18:00", "text~": "mam"}, "max_words": 15}
{"lang": "sl", "say": "jutri ob sedmih zjutraj me opomni, naj odnesem smeti", "expect_tool": "set_reminder", "expect_args": {"when": "2026-10-03T07:00", "text~": "smeti"}, "max_words": 15}
{"lang": "sl", "say": "nocoj ob pol devetih me opomni, naj napolnim luči za kolo", "expect_tool": "set_reminder", "expect_args": {"when": "2026-10-02T20:30", "text~": "luč"}, "max_words": 15}
{"lang": "sl", "say": "v ponedeljek ob devetih me opomni, naj pišem učiteljici", "expect_tool": "set_reminder", "expect_args": {"when": "2026-10-05T09:00", "text~": "učitelj"}, "max_words": 15}
{"lang": "sl", "say": "čez dve uri me opomni, naj zalijem rože", "expect_tool": "set_reminder", "expect_args": {"when": "2026-10-02T17:10", "text~": "rož"}, "max_words": 15, "note": "opravilo z zamikom je opomnik, ne časovnik"}
{"lang": "sl", "say": "opomni me čez dvajset minut, naj se pretegnem", "expect_tool": "set_reminder", "expect_args": {"when": "2026-10-02T15:30", "text~": "preteg"}, "max_words": 15}
{"lang": "sl", "say": "jutri opoldne me opomni na zobozdravnika", "expect_tool": "set_reminder", "expect_args": {"when": "2026-10-03T12:00", "text~": "zobozdravnik"}, "max_words": 15}
{"lang": "sl", "say": "opomni me ob četrt na osem zvečer, da je tekma", "expect_tool": "set_reminder", "expect_args": {"when": "2026-10-02T19:15", "text~": "tekm"}, "max_words": 15, "note": "četrt na osem je 19:15, ne 20:15"}
{"lang": "sl", "say": "opomni me, naj pokličem babico", "expect_tool": null, "expect_question": true, "max_words": 25, "note": "ni časa: vprašati mora, kdaj"}
# --- časovniki: odštevanje brez opravila
{"lang": "sl", "say": "nastavi časovnik na deset minut", "expect_tool": "set_timer", "expect_args": {"seconds": 600}, "max_words": 12, "local": true}
{"lang": "sl", "say": "časovnik za devetdeset sekund", "expect_tool": "set_timer", "expect_args": {"seconds": 90}, "max_words": 12}
{"lang": "sl", "say": "nastavi časovnik za testenine na dvanajst minut", "expect_tool": "set_timer", "expect_args": {"seconds": 720, "label~": "testenine"}, "max_words": 12}
{"lang": "sl", "say": "odštej pet minut za moj čaj", "expect_tool": "set_timer", "expect_args": {"seconds": 300}, "max_words": 12}
{"lang": "sl", "say": "zbudi me čez uro in pol", "expect_tool": ["set_timer", "set_reminder"], "max_words": 15, "expect_args": [{"seconds": 5400}, {"when": "2026-10-02T16:40"}]}
{"lang": "sl", "say": "nastavi časovnik", "expect_tool": null, "expect_question": true, "max_words": 20, "note": "ni dolžine: vprašati mora, za koliko časa"}
# --- seznam in preklic
{"lang": "sl", "say": "katere opomnike imam", "reminders": [{"text": "pokliči mamo", "when": "2026-10-02T18:00"}, {"text": "nahrani mačko", "when": "2026-10-03T08:00"}], "expect_tool": "list_reminders", "reply_matches": "mam", "max_words": 40}
{"lang": "sl", "say": "prekliči opomnik za mačko", "reminders": [{"text": "pokliči mamo", "when": "2026-10-02T18:00"}, {"text": "nahrani mačko", "when": "2026-10-03T08:00"}], "expect_tool": "cancel_reminder", "also_ok": ["list_reminders"], "max_words": 20, "reply_matches": "preklic|izbris|odstran"}
{"lang": "sl", "say": "ali imam jutri kaj v načrtu", "reminders": [{"text": "nahrani mačko", "when": "2026-10-03T08:00"}], "expect_tool": "list_reminders", "reply_matches": "mačk", "max_words": 40}
# --- spomin
{"lang": "sl", "say": "zapomni si, da je moji sestri ime Ana", "expect_tool": "save_memory", "expect_args": {"text~": "Ana"}, "max_words": 12}
{"lang": "sl", "say": "zapomni si, da imam rad metin čaj", "expect_tool": "save_memory", "expect_args": {"text~": "metin"}, "max_words": 12}
{"lang": "sl", "say": "alergičen sem na arašide, zapomni si to", "expect_tool": "save_memory", "max_words": 15, "expect_args": {"text~": "araš"}}
{"lang": "sl", "say": "moj najljubši čaj je metin", "expect_tool": "save_memory", "max_words": 15, "expect_args": {"text~": "met"}}
{"lang": "sl", "say": "kako je ime moji sestri", "memories": ["Uporabnikovi sestri je ime Ana."], "expect_tool": [], "also_ok": ["search_memory"], "reply_matches": "Ana", "max_words": 15}
{"lang": "sl", "say": "pozabi, da imam rad metin čaj", "memories": ["Uporabnik ima rad metin čaj."], "expect_tool": [], "also_ok": ["search_memory", "forget_memory"], "expect_question": true, "max_words": 25, "note": "pozabljanje najprej vpraša"}
{"lang": "sl", "say": "kako je ime mojemu psu", "expect_tool": [], "also_ok": ["search_memory"], "reply_not": "\\b(Reks|Piki|Runo|Bela)\\b", "max_words": 25, "note": "tega ne ve in si imena ne sme izmisliti"}
