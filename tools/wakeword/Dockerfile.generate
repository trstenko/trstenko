# Text -> wake-word .wav files. PyTorch + piper-sample-generator (MIT) +
# piper (GPL-3.0-or-later, needed only for phonemization/onnx synthesis).
#
# GPL code lives in this image and nowhere else in the repo. It produces
# audio files as output, never gets copied into `train`'s image or into
# `firmware/`, and this image is never pushed anywhere a customer could
# pull it. See LICENSES.md.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3.11-dev python3-pip git wget \
        espeak-ng build-essential ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

WORKDIR /work

RUN pip install --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/cu124

# Not `pip install piper-sample-generator`: the wheel on PyPI omits
# `piper_train/`, which `piper_sample_generator/__main__.py` imports for the
# .pt (LibriTTS-R generator) code path. The notebook works around this by
# cloning the repo so both packages sit side by side on the path -- do the
# same rather than fighting the packaging. Versions pinned to match the
# clone's own pyproject.toml (piper-sample-generator 3.2.0).
RUN git clone --depth 1 https://github.com/rhasspy/piper-sample-generator /work/piper-sample-generator \
    && pip install --no-cache-dir \
        "audiomentations==0.33.0" "piper-tts==1.3.0" webrtcvad requests
ENV PYTHONPATH=/work/piper-sample-generator

RUN mkdir -p models \
    && wget -q -O models/en_US-libritts_r-medium.pt \
        'https://github.com/rhasspy/piper-sample-generator/releases/download/v2.0.0/en_US-libritts_r-medium.pt' \
    && wget -q -O models/en_US-libritts_r-medium.pt.json \
        'https://huggingface.co/datasets/rhasspy/piper-checkpoints/resolve/main/en/en_US/libritts_r/medium/config.json' \
    && mkdir -p voices \
    && wget -q -O voices/sl_SI-artur-medium.onnx \
        'https://huggingface.co/rhasspy/piper-voices/resolve/main/sl/sl_SI/artur/medium/sl_SI-artur-medium.onnx?download=true' \
    && wget -q -O voices/sl_SI-artur-medium.onnx.json \
        'https://huggingface.co/rhasspy/piper-voices/resolve/main/sl/sl_SI/artur/medium/sl_SI-artur-medium.onnx.json?download=true'

CMD ["bash"]
